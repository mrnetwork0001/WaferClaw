# ============================================================================
# WaferClaw configuration: OpenClaw + Kimi K3.1 Pro on Cerebras
# Copy this file to .env.local and add your Cerebras API key
# ============================================================================

# Required: Cerebras Inference Cloud API Key (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=csk-your-cerebras-api-key-here

# Cerebras OpenAI-Compatible Endpoint & Primary Hackathon Model
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=moonshotai-kimi-k3.1-pro-trial

# Optional: models to fall back to only if Kimi cannot be reached at all (the UI always shows which model ran)
CEREBRAS_FALLBACK_MODELS=gpt-oss-120b,qwen-3.8-27b

# OpenClaw runs from an isolated install in .openclaw-sandbox/ (created by: npm run setup:openclaw)

# Optional: a real side-by-side race. As a run starts, one identical request is sent to Cerebras
# and to each rival below (a GPU host with an OpenAI-compatible API), and every stream is timed the
# same way. Leave these unset and no comparison is shown at all (nothing is ever simulated).
# Name the lane after the host that actually serves the request. On an aggregator such as
# OpenRouter, pin one upstream host and turn fallbacks off, as in RACE_EXTRA_BODY below.
# RACE_LABEL="DigitalOcean"
# RACE_BASE_URL=https://openrouter.ai/api/v1
# RACE_API_KEY=
# RACE_MODEL=moonshotai/kimi-k3.1-pro
# Optional JSON merged into the rival request. It cannot change the model, the messages, the
# streaming flags or the output cap, which are the same for every lane.
# RACE_EXTRA_BODY='{"provider":{"only":["digitalocean"],"allow_fallbacks":false},"reasoning":{"effort":"low"}}'
# Optional note shown next to the rival on screen. Write only what the host itself publishes.
# RACE_NOTE="GPU cloud, quantization not published, via OpenRouter"
# A second and third rival: RACE2_* and RACE3_* (LABEL, EXTRA_BODY, NOTE). They reuse rival 1's
# base URL, key and model unless they set their own. A rival with its own base URL needs its own key.
# RACE2_LABEL="Modal"
# RACE2_EXTRA_BODY='{"provider":{"only":["modal"],"allow_fallbacks":false},"reasoning":{"effort":"low"}}'
# RACE2_NOTE="GPU cloud, MXFP4 as released, via OpenRouter"
# Output cap for every lane (default 1500, allowed 800 to 8000). A lower cap costs less. A lane
# that produces fewer than 600 tokens after its first chunk is reported as too small to time.
# RACE_MAX_TOKENS=1500
