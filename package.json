{
  "name": "waferclaw",
  "version": "1.0.0",
  "private": true,
  "description": "WaferClaw: a local dashboard around a real OpenClaw agent running Kimi K3.1 Pro on Cerebras, showing measured decode speed and a same-request race against GPU hosts",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3210",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3210",
    "lint": "next lint",
    "setup:openclaw": "bash scripts/setup-openclaw.sh",
    "bounty": "node scripts/benchmark-shopper.mjs"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}
